<!DOCTYPE html>
<html lang="ru">
  <head>
    <title>Администрирование — Вектор</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="admin">
    <header class="admin-header">
      <%= link_to admin_root_path, class: "admin-header__brand", aria: { label: "Вектор — управление контентом" } do %>
        <%= image_tag "logo.svg", alt: "Вектор" %>
      <% end %>
      <span class="admin-header__title">панель администратора</span>
      <div class="admin-header__account">
        <span><%= current_user.display_name %></span>
        <%= link_to root_path, class: "admin-header__site" do %>
          на сайт <%= image_tag "black_arrow.svg", alt: "" %>
        <% end %>
        <%= button_to "Выйти", destroy_user_session_path, method: :delete, class: "admin-button admin-button--secondary" %>
      </div>
    </header>
    <nav class="admin-nav" aria-label="Разделы администрирования">
      <%= link_to "Статьи", admin_articles_path, aria: { current: controller_name == "articles" ? "page" : nil } %>
      <%= link_to "Категории", admin_categories_path, aria: { current: controller_name == "categories" ? "page" : nil } %>
      <%= link_to "Тесты", admin_quizzes_path, aria: { current: controller_name == "quizzes" ? "page" : nil } %>
    </nav>
    <main class="admin-main" id="admin-content">
      <% if notice.present? %><p class="notice" role="status"><%= notice %></p><% end %>
      <% if alert.present? %><p class="alert" role="alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
