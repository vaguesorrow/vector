<% content_for :title, "Регистрация — Вектор" %>
<%= render layout: "devise/shared/auth_frame", locals: { heading: "задай свой вектор", description: "Создай аккаунт и начни свой путь к поступлению в российский вуз.", form_label: "Регистрация аккаунта" } do %>
  <h2>создать аккаунт</h2>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="auth-field">
      <%= f.label :display_name, "Имя" %>
      <%= f.text_field :display_name, required: true, autofocus: true, autocomplete: "name" %>
    </div>
    <div class="auth-field">
      <%= f.label :email, "Электронная почта" %>
      <%= f.email_field :email, required: true, autocomplete: "email" %>
    </div>
    <div class="auth-field">
      <%= f.label :password, "Пароль" %>
      <%= f.password_field :password, required: true, autocomplete: "new-password", minlength: @minimum_password_length, aria: { describedby: ("password-hint" if @minimum_password_length) } %>
      <% if @minimum_password_length %><p class="auth-hint" id="password-hint">Не менее <%= @minimum_password_length %> символов</p><% end %>
    </div>
    <div class="auth-field">
      <%= f.label :password_confirmation, "Повтори пароль" %>
      <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
    </div>
    <%= f.button type: "submit", class: "auth-submit" do %>
      <span>зарегистрироваться</span><%= image_tag "black_arrow.svg", alt: "", class: "design-arrow" %>
    <% end %>
  <% end %>
  <p class="auth-switch">Уже есть аккаунт? <%= link_to "Войти", new_session_path(resource_name) %></p>
<% end %>
